# yamllint for adrcheck. GitHub workflow files use `on:` and have no document start.
extends: default
ignore: |
  .beads/
  .agents/
  .claude/
  .codex/
  .cursor/
rules:
  line-length:
    max: 120
  document-start: disable
  truthy:
    allowed-values: ["true", "false", "on", "off"]
  comments:
    min-spaces-from-content: 1
